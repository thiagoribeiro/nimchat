# Required: your Nimlet server. The browser calls it directly, so it must allow this origin.
NEXT_PUBLIC_NIMLET_URL=http://localhost:8080

# Required for build:release: public provisioned user IDs, comma-separated.
# Display names cannot establish publisher/agent trust.
NEXT_PUBLIC_BRIAN_AGENT_IDS=
NEXT_PUBLIC_BRIAN_PUBLISHER_IDS=

# Enable after the agent-blocks sharing runtime and room-admin adapter are deployed.
NEXT_PUBLIC_BRIAN_SHARING_ENABLED=false
NEXT_PUBLIC_BRIAN_MONTHLY_BILLS_ENABLED=false
NEXT_PUBLIC_BRIAN_SURFACE_NAMES_ENABLED=true
NEXT_PUBLIC_NIMLET_NAMESPACE=default
