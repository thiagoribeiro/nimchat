# Required: your Nimlet server, reachable from the device.
EXPO_PUBLIC_NIMLET_URL=http://10.0.2.2:8080
# Required for build:release: public provisioned user IDs, comma-separated.
EXPO_PUBLIC_BRIAN_AGENT_IDS=
EXPO_PUBLIC_BRIAN_PUBLISHER_IDS=

# Enable after the agent-blocks sharing runtime and room-admin adapter are deployed.
EXPO_PUBLIC_BRIAN_SHARING_ENABLED=false
EXPO_PUBLIC_BRIAN_MONTHLY_BILLS_ENABLED=false
EXPO_PUBLIC_BRIAN_SURFACE_NAMES_ENABLED=true
EXPO_PUBLIC_NIMLET_NAMESPACE=default
